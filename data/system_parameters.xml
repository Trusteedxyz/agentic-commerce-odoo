<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Defaults — operator must overwrite via Settings → Technical → System Parameters -->
    <record id="param_merchant_id" model="ir.config_parameter">
      <field name="key">trusteed.merchant_id</field>
      <field name="value"></field>
    </record>
    <record id="param_bootstrap_secret" model="ir.config_parameter">
      <field name="key">trusteed.bootstrap_secret</field>
      <field name="value"></field>
    </record>
    <record id="param_api_base" model="ir.config_parameter">
      <field name="key">trusteed.api_base</field>
      <field name="value">https://api.trusteed.xyz</field>
    </record>
  </data>
</odoo>
